DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # BEGIN BOOK ID REDIRECTS
  # END BOOK ID REDIRECTS

  # Avoid duplicate /books/<id>.html URLs; the canonical URL has no suffix.
  RewriteCond %{THE_REQUEST} \s/+books/([^/]+)\.html[\s?] [NC]
  RewriteRule ^books/([^/]+)\.html$ /books/$1 [R=301,L]

  # Serve prerendered book pages: /books/15 -> /books/15.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^books/([A-Za-z0-9_-]+)/?$ books/$1.html [L]

  # /books/ is the admin book-management SPA route, not a missing book file.
  RewriteRule ^books/?$ index.html [L]

  # Missing book files must return 404 instead of falling through to the SPA.
  RewriteRule ^books/ - [L]

  # Unknown taxonomy paths (removed tags, renamed categories, etc.) must return
  # 404 instead of serving the SPA homepage as a soft 404.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(categories|tags|series)(/.*)?$ - [R=404,L]

  # SPA fallback for all other client-side routes.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <Files "robots.txt">
    Header set Cache-Control "public, max-age=300"
  </Files>
  <Files "sitemap.xml">
    Header set Cache-Control "public, max-age=300"
  </Files>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|gif|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
